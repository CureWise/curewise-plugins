  "keywords": ["mcp", "health", "clinical", "curewise"],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "CureWise API key",
      "description": "Create one at https://app.curewise.com/me/api-keys",
      "sensitive": true,
      "required": true
    }
  }
}
